{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ui-static",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:static", "--", "--port", "5174", "--strictPort"],
      "cwd": "ui",
      "port": 5174
    },
    {
      "name": "ui-live",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "cwd": "ui",
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "cadence.api.server:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    }
  ]
}
