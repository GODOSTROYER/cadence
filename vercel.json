{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ui && npm ci",
  "buildCommand": "cd ui && npm run build:vercel",
  "outputDirectory": "ui/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{src/**,config/**,docs/BRAND_VOICE.md,data/processed/spotify_threads.jsonl.gz,data/processed/link_map.json,data/golden/golden_set.jsonl,cache/llm_cache.sqlite,results/ui/**}"
    }
  },
  "rewrites": [
    {
      "source": "/hiver-assignment/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/hiver-assignment",
      "destination": "/hiver-assignment/index.html"
    },
    {
      "source": "/hiver-assignment/((?!api/|assets/|data/|favicon).*)",
      "destination": "/hiver-assignment/index.html"
    }
  ],
  "headers": [
    {
      "source": "/hiver-assignment",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/hiver-assignment/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/hiver-assignment/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/hiver-assignment/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hiver-assignment/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.arnavbule.in/hiver-assignment/",
      "permanent": false
    }
  ]
}
