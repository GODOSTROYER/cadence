# Copy to .env and fill in. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults live in config/models.yaml)
# CADENCE_AGENT_MODEL=gemini-2.5-flash
# CADENCE_JUDGE_MODEL=gemini-2.5-pro
# CADENCE_ZERO_SHOT_MODEL=gemini-2.5-flash-lite

# Set to 1 to forbid any network call and replay everything from cache/llm_cache.sqlite
# CADENCE_CACHE_ONLY=1

# Set to "mock" to use the deterministic offline mock client (tests / smoke runs)
# CADENCE_LLM=mock
